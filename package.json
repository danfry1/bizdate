{
  "name": "bizdate",
  "version": "0.1.0",
  "description": "Zero-dependency business-day, market-calendar and day-count math for TypeScript: ISDA/ICMA day count conventions as exact fractions, rule-based exchange calendars (NYSE, SIFMA, TARGET2, LSE), roll conventions, payment schedules, and exact integer-minor-unit accrual & amortization",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danfry1/bizdate.git"
  },
  "homepage": "https://github.com/danfry1/bizdate#readme",
  "bugs": {
    "url": "https://github.com/danfry1/bizdate/issues"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --type-aware --deny-warnings src tests scripts benchmarks",
    "format": "oxfmt src tests scripts benchmarks tsdown.config.ts vitest.config.ts",
    "format:check": "oxfmt --check src tests scripts benchmarks tsdown.config.ts vitest.config.ts",
    "knip": "knip",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "check:package": "bun run build && bun run smoke:package",
    "check:release": "bun run check:deps && bun run format:check && bun run lint && bun run knip && bun run typecheck && bun run test:coverage && bun run check:package && bun run test:dist",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "bench": "vitest bench --run",
    "prepare": "test -n \"$CI\" || lefthook install",
    "prepublishOnly": "bun run check:release",
    "check:deps": "syncpack lint",
    "attw": "attw",
    "smoke:package": "bun run scripts/check-package.ts",
    "test:mutation": "stryker run"
  },
  "keywords": [
    "business-days",
    "business-day",
    "working-days",
    "holidays",
    "holiday-calendar",
    "market-calendar",
    "trading-calendar",
    "nyse",
    "target2",
    "sifma",
    "settlement",
    "day-count",
    "day-count-convention",
    "30-360",
    "act-360",
    "act-365",
    "isda",
    "icma",
    "accrued-interest",
    "accrual",
    "amortization",
    "amortisation",
    "payment-schedule",
    "finance",
    "fintech",
    "date",
    "moment-business-days"
  ],
  "author": "Daniel Fry",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "fast-check": "4.9.0",
    "knip": "6.26.0",
    "lefthook": "2.1.10",
    "npm": "11.15.0",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "0.24.0",
    "syncpack": "15.3.3",
    "tsdown": "0.22.4",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
